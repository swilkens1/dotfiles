[toplevel]

# Whoami: which identity is the current profile resolving to?
whoami = sts get-caller-identity

# List all enabled regions, one per line.
regions = ec2 describe-regions --query Regions[].RegionName --output text

# Running instances in the current region as a table (id, name, type).
running =
  ec2 describe-instances
    --filters Name=instance-state-name,Values=running
    --query 'Reservations[].Instances[].[InstanceId,Tags[?Key==`Name`]|[0].Value,InstanceType]'
    --output table
